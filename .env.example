# ==============================================================================
# MailSentra SOC (PhishGuard SOC) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# NOTE: Safe placeholders are provided below. Replace placeholders with secure
# values for production deployments. Never commit actual secret keys or credentials.
# ==============================================================================

# Database Connection URL (PostgreSQL)
# Format: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+psycopg://phishguard:phishguard_password@postgres:5432/phishguard

# PostgreSQL Container Credentials (used by Docker Compose)
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=phishguard_password
POSTGRES_DB=phishguard

# JWT Authentication
# Replace with a high-entropy cryptographically secure random string in production:
# e.g., generated with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (comma-separated list for frontend access)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory where generated PDF incident reports are saved
REPORT_DIR=generated_reports

# Optional Institution / Enterprise Brand Watchlist Defaults
COLLEGE_DOMAIN=
COLLEGE_NAME=

# Frontend API Target (Vite Environment Variable)
VITE_API_URL=http://localhost:8000
